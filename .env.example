# Copie este arquivo para .env.local (que NAO vai para o Git) e ajuste.
# NUNCA coloque senha ou chave reais neste arquivo: o repositorio e publico.

# Banco de dados (padrao do XAMPP: porta 3306, usuario root, sem senha).
# Se o seu MariaDB usa outra porta (ex.: 3307), mude aqui e no config.local.php.
MACHSENSE_DB_HOST=127.0.0.1
MACHSENSE_DB_PORT=3306
MACHSENSE_DB_NAME=machsense
MACHSENSE_DB_USER=root
MACHSENSE_DB_PASSWORD=

# Chave que o simulador envia no cabecalho X-API-Key. A API se recusa a subir
# sem ela (minimo 16 caracteres). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(24))"
MACHSENSE_API_KEY=troque-a-chave

# Botao "Iniciar simulacao" do site (pagina Simulacao no menu). Vem DESLIGADO.
# Para ligar, troque para 1. So funciona para o administrador e no proprio
# computador, e a API (iniciar_api.bat) precisa estar rodando.
MACHSENSE_SIMULACAO_NO_SITE=0
# Endereco da API. O site so aceita enderecos deste computador.
MACHSENSE_API_URL=http://127.0.0.1:8000
